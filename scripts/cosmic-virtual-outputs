#!/usr/bin/env python3
# Create one virtual output device per hardware output port, so any volume
# panel can switch between them. Enabled through the `virtual_outputs` key of
# `com.system76.CosmicAudio`; the settings page writes it.
import json
import os
import re
import signal
import subprocess
import sys
import threading
import time

HW = os.environ.get(
    "VIRTUAL_OUTPUTS_SINK", "alsa_output.pci-0000_04_00.6.analog-stereo"
)
CONF = os.path.expanduser("~/.config/cosmic/com.system76.CosmicAudio/v1/virtual_outputs")
PREFIX = "virtual."
LATENCY_MS = 10

state = {"enabled": False, "sinks": {}, "modules": {}, "volume": None, "mute": None}
lock = threading.Lock()


def pactl(*args):
    try:
        return subprocess.run(
            ["pactl", *args], capture_output=True, text=True, timeout=10
        ).stdout
    except (subprocess.TimeoutExpired, OSError) as why:
        print(f"pactl {args} failed: {why}", file=sys.stderr, flush=True)
        return ""


def log(msg):
    print(msg, file=sys.stderr, flush=True)


def config_enabled():
    try:
        with open(CONF, encoding="utf-8") as f:
            return f.read().strip().lower() == "true"
    except OSError:
        return False


def port_descriptions():
    """Localized port descriptions from the human-readable output."""
    out = pactl("list", "sinks")
    descriptions = {}
    for line in out.splitlines():
        match = re.match(r"^\s+(analog-output-[\w-]+): (.*?) \(type:", line)
        if match:
            descriptions[match.group(1)] = match.group(2)
    return descriptions


def hardware_sink():
    try:
        sinks = json.loads(pactl("-f", "json", "list", "sinks"))
    except json.JSONDecodeError:
        return None
    for sink in sinks:
        if sink.get("name") == HW:
            return sink
    return None


def hardware_ports():
    sink = hardware_sink()
    if not sink:
        return []
    descriptions = port_descriptions()
    return [
        {
            "name": port["name"],
            "description": descriptions.get(port["name"], port["name"]),
        }
        for port in sink.get("ports", [])
        if port["name"].startswith("analog-output-")
    ]


def current_default():
    return pactl("get-default-sink").strip()


def current_port():
    sink = hardware_sink()
    return (sink or {}).get("active_port")


def saved_volume():
    match = re.search(r"(\d+)%", pactl("get-sink-volume", HW))
    return f"{match.group(1)}%" if match else None


def saved_mute():
    return "yes" if "yes" in pactl("get-sink-mute", HW).lower() else "no"


def load_module(*args):
    return pactl("load-module", *args).strip()


def enable():
    ports = hardware_ports()
    if not ports:
        log("no output ports found on the hardware sink")
        return

    state["volume"] = saved_volume()
    state["mute"] = saved_mute()
    pactl("set-sink-mute", HW, "no")
    pactl("set-sink-volume", HW, "100%")

    for port in ports:
        sink = PREFIX + port["name"]
        null = load_module(
            "module-null-sink",
            f"sink_name={sink}",
            f'sink_properties=device.description="{port["description"]}"',
        )
        loop = load_module(
            "module-loopback",
            f"source={sink}.monitor",
            f"sink={HW}",
            f"latency_msec={LATENCY_MS}",
            "source_dont_move=true",
            "sink_dont_move=true",
            f'sink_input_properties="media.name={port["description"]}（回环） application.name=端口回环"',
            f'source_output_properties="media.name={port["description"]}（回环） application.name=端口回环"',
        )
        if not null or not loop:
            log(f"failed to create modules for {sink}")
            continue
        if state["volume"]:
            pactl("set-sink-volume", sink, state["volume"])
        state["modules"][sink] = (null, loop)
        state["sinks"][sink] = port["name"]

    if not state["sinks"]:
        disable()
        return

    # Follow the port that is currently in use.
    target = PREFIX + current_port() if current_port() else None
    if target not in state["sinks"]:
        target = next(iter(state["sinks"]))
    pactl("set-default-sink", target)
    log(f"enabled: {', '.join(state['sinks'])}")


def disable():
    for sink, (null, loop) in state["modules"].items():
        pactl("unload-module", loop)
        pactl("unload-module", null)
    state["modules"].clear()
    state["sinks"].clear()

    pactl("set-default-sink", HW)
    if state["volume"]:
        pactl("set-sink-volume", HW, state["volume"])
    if state["mute"]:
        pactl("set-sink-mute", HW, state["mute"])
    state["volume"] = None
    state["mute"] = None
    log("disabled")


def sync_route():
    """Keep the hardware port in sync with the selected virtual device."""
    port = state["sinks"].get(current_default())
    if port and current_port() != port:
        pactl("set-sink-port", HW, port)
        log(f"port -> {port}")


def modules_alive():
    if not state["sinks"]:
        return True
    names = pactl("list", "short", "sinks")
    return all(sink in names for sink in state["sinks"])


def subscribe_loop():
    while True:
        process = subprocess.Popen(
            ["pactl", "subscribe"],
            stdout=subprocess.PIPE,
            text=True,
            env={**os.environ, "LC_ALL": "C"},
        )
        for line in process.stdout:
            if "on server" in line or "on sink" in line:
                with lock:
                    if state["enabled"]:
                        sync_route()
        process.wait()
        time.sleep(1)


def control_loop():
    while True:
        with lock:
            want = config_enabled()
            if want and not state["enabled"]:
                state["enabled"] = True
                enable()
            elif not want and state["enabled"]:
                disable()
                state["enabled"] = False
            elif want and not modules_alive():
                log("virtual sinks disappeared; recreating")
                disable()
                enable()
        time.sleep(1)


def stop(signum, frame):
    with lock:
        if state["enabled"]:
            disable()
    sys.exit(0)


def main():
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)

    with lock:
        if config_enabled():
            state["enabled"] = True
            enable()

    threading.Thread(target=subscribe_loop, daemon=True).start()
    control_loop()


if __name__ == "__main__":
    main()
